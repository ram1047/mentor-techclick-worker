{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mentor-techclick",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "65aa28b5b1d1c233c0ab798f79342c5b",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "mentor.techclick.in", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mentor-techclick",
      "database_id": "36da40f5-7559-499f-b034-72f5599309c0",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_URL": "https://mentor.techclick.in",
    "SUPPORT_WHATSAPP": "919277229456",
    "SUPPORT_EMAIL": "support@techclick.in"
  }
}
